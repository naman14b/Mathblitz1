{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend/"
        },
        "backend": {
            "root": "backend/",
            "framework": "fastapi",
            "entrypoint": "backend.server:app"
        }
    },
    "rewrites": [
        {
            "source": "/app-ads.txt",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/api",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/privacy-policy(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/",
            "destination": {
                "service": "backend"
            }
        }
    ]
}