{
  "expo": {
    "name": "FunGanit",
    "slug": "mathblitz-60s",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mathblitz-icon.jpg",
    "scheme": "mathblitz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naman.mathblitz",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick images for admin challenge questions"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mathblitz-icon.jpg",
        "backgroundColor": "#FF6B35"
      },
      "package": "com.naman.mathblitz",
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/mathblitz-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mathblitz-icon.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFDF9"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick images for admin challenge questions"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dc659a7-a048-4e1f-b913-20ac7cacce1a"
      }
    },
    "owner": "namanbansal23"
  }
}